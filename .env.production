# The product's public demo-request endpoint. Inlined at build time — NEXT_PUBLIC_ vars are
# compiled into the export, so changing this needs a rebuild, not a restart.
#
# Leave it EMPTY to fall back to the pre-filled email path. That is a working fallback, not a
# broken state: the form never discards a submission either way.
NEXT_PUBLIC_DEMO_ENDPOINT=https://app.lenviq.in/api/public/demo-request

# Where the signup form posts. Blank means the product's own API on `SITE.appUrl`, which is what
# production wants; it exists so a local site (port 3100) can reach a local product (port 3000)
# without editing a component — see README, "Running against a local product".
NEXT_PUBLIC_SIGNUP_API=
